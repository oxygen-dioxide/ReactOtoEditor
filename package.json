{
  "name": "reactotoeditor",
  "version": "0.0.1",
  "main": "index.js",
  "engines": {
    "vscode": "^1.51.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "laberu.otoEditor",
        "displayName": "Laberu Oto.ini editor",
        "selector": [
          {
            "filenamePattern": "oto.ini"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "repository": {
		"type": "git",
		"url": "https://github.com/delta-kimigatame/ReactOtoEditor"
	},
  "activationEvents": [],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "cross-env BUILD_TARGET=web vite build",
    "build:vscode": "tsc -p ./tsconfig.json && cross-env BUILD_TARGET=vscode vite build && vsce package",
    "build:all": "npm run build:web && npm run build:vscode",
    "preview": "vite preview",
    "makedoc": "npx typedoc --entryPointStrategy expand ./src --htmlLang jp --cleanOutputDir false",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o docs/storybook"
  },
  "keywords": [],
  "author": "delta_kimigatame",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^5.0.13",
    "@mui/icons-material": "^5.15.19",
    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/material": "^5.15.19",
    "@mui/styled-engine-sc": "^6.0.0-alpha.18",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.108.1",
    "@vscode/vsce": "^3.7.1",
    "i18next": "^23.11.5",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-cookie": "^7.1.4",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.13",
    "react-i18next": "^14.1.2",
    "styled-components": "^6.1.11",
    "utauoto": "^0.5.1",
    "utauwav": "^0.6.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-react": "^7.24.6",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/react-vite": "^10.1.4",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^10.1.0",
    "playwright": "^1.57.0",
    "storybook": "^10.1.4",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5",
    "vite": "^6.2.6",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.1"
  }
}
