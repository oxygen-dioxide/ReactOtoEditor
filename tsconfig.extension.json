{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "sourceMap": true,             // 必须开启：生成 .map 文件
    "rootDir": "src",              // 源码目录
    "outDir": "./dist-extension",    // 编译产物目录
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["__tests__/**/*", "node_modules"]
}